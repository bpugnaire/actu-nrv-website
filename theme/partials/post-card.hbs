<article class="story-card {{#if feature_image}}story-card--image{{/if}}">
    {{#if feature_image}}
        <a class="story-card__media" href="{{url}}" tabindex="-1" aria-hidden="true">
            <img
                srcset="{{img_url feature_image size='s'}} 480w, {{img_url feature_image size='m'}} 800w, {{img_url feature_image size='l'}} 1200w"
                sizes="(max-width: 720px) 100vw, 33vw"
                src="{{img_url feature_image size='m'}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                loading="lazy"
            >
        </a>
    {{/if}}
    <div class="story-card__body">
        {{#primary_tag}}<a class="kicker" href="{{url}}">{{name}}</a>{{/primary_tag}}
        <h3><a href="{{url}}">{{title}}</a></h3>
        <p>{{excerpt words="23"}}</p>
        <div class="story-meta">
            <time datetime="{{date format='YYYY-MM-DD'}}">{{date format="D MMMM YYYY"}}</time>
            <span>{{reading_time minute="1 min" minutes="% min"}}</span>
        </div>
    </div>
</article>
