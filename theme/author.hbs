{{!< default}}

{{#author}}
<header class="archive-header archive-header--author shell">
    {{#if profile_image}}<img src="{{profile_image}}" alt="">{{/if}}
    <div><p class="eyebrow">La rédaction</p><h1>{{name}}</h1>{{#if bio}}<p>{{bio}}</p>{{/if}}</div>
</header>
{{/author}}
<section class="section shell">
    <div class="story-grid">{{#foreach posts}}{{> post-card}}{{/foreach}}</div>
    {{pagination}}
</section>
