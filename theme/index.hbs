{{!< default}}

<section class="edition shell">
    {{#get "posts" filter="featured:true" limit="1" include="tags,authors"}}
        {{#foreach posts}}
            <article class="lead-story">
                <a class="lead-story__media" href="{{url}}" tabindex="-1" aria-hidden="true">
                    {{#if feature_image}}
                        <img
                            srcset="{{img_url feature_image size='m'}} 800w, {{img_url feature_image size='l'}} 1200w, {{img_url feature_image size='xl'}} 1800w"
                            sizes="(max-width: 860px) 100vw, 68vw"
                            src="{{img_url feature_image size='xl'}}"
                            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        >
                    {{else}}
                        <img src="{{asset 'images/nice-editorial-cover.jpg'}}" alt="Nice, sa vieille ville et la Méditerranée vues depuis une terrasse">
                    {{/if}}
                </a>
                <div class="lead-story__body">
                    {{#primary_tag}}<a class="kicker" href="{{url}}">{{name}}</a>{{/primary_tag}}
                    <h1><a href="{{url}}">{{title}}</a></h1>
                    <p>{{excerpt words="36"}}</p>
                    <div class="story-meta story-meta--light">
                        <span>Par {{authors}}</span>
                        <time datetime="{{date format='YYYY-MM-DD'}}">{{date format="D MMMM YYYY"}}</time>
                    </div>
                </div>
            </article>
        {{else}}
            <article class="lead-story lead-story--fallback">
                <img class="lead-story__media" src="{{asset 'images/nice-editorial-cover.jpg'}}" alt="Nice, sa vieille ville et la Méditerranée vues depuis une terrasse">
                <div class="lead-story__body">
                    <span class="kicker">Le journal de Nice</span>
                    <h1>La ville se raconte ici.</h1>
                    <p>Actualités, histoire, culture, gastronomie et rendez-vous de Nice et de la Côte d’Azur.</p>
                </div>
            </article>
        {{/foreach}}
    {{/get}}

    <aside class="edition-note">
        <p class="eyebrow">Le mot de la rédaction</p>
        <blockquote>« Regarder Nice avec curiosité, raconter ceux qui la font vivre et transmettre sa mémoire. »</blockquote>
        <a class="text-link" href="{{@site.url}}/a-propos/">Notre histoire →</a>
    </aside>
</section>

<section class="section shell latest-section">
    <header class="section-heading">
        <div>
            <p class="eyebrow">Le fil niçois</p>
            <h2>Les dernières nouvelles</h2>
        </div>
        <a class="text-link" href="{{@site.url}}/archive/">Voir toutes les actualités →</a>
    </header>
    <div class="story-grid">
        {{#foreach posts}}
            {{> post-card}}
        {{/foreach}}
    </div>
    {{pagination}}
</section>

<section class="discover-section">
    <div class="shell">
        <header class="section-heading section-heading--discover">
            <div>
                <p class="eyebrow eyebrow--light">Une ville, mille histoires</p>
                <h2>Découvrir Nice</h2>
            </div>
            <p>Des repères vivants pour comprendre la ville, ses traditions et son territoire.</p>
        </header>
        <div class="discover-grid">
            <a href="{{@site.url}}/histoire/" class="discover-card discover-card--wide">
                <span>01</span><h3>Histoire</h3><p>De Nikaïa au Comté de Nice, les dates et les visages qui ont façonné la ville.</p>
            </a>
            <a href="{{@site.url}}/identite/" class="discover-card">
                <span>02</span><h3>Identité</h3><p>Langue, fêtes, musique et traditions niçoises.</p>
            </a>
            <a href="{{@site.url}}/visites/" class="discover-card">
                <span>03</span><h3>Visites</h3><p>Quartiers, monuments et itinéraires à parcourir.</p>
            </a>
            <a href="{{@site.url}}/villes-villages/" class="discover-card discover-card--wide">
                <span>04</span><h3>Villes & villages</h3><p>Du littoral aux vallées, explorer le pays niçois et la Provence orientale.</p>
            </a>
        </div>
    </div>
</section>
